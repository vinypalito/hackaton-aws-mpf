{
  "name": "@painel/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Scripts operacionais (carga do seed, migração, restauração, destruir).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
